#!/usr/bin/env bash
# Start the app: SERVER=serve|roadrunner|frankenphp (default roadrunner).
set -euo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# PHP: $PHP_BIN, else the gitignored local wrapper tools/dev/php, else php on PATH.
if [[ -n "${PHP_BIN:-}" ]]; then PHP="$PHP_BIN"; elif [[ -x "$PWD/tools/dev/php" ]]; then PHP="$PWD/tools/dev/php"; else PHP="$(command -v php)"; fi
SERVER="${SERVER:-roadrunner}"
./install.sh --check >/dev/null
case "$SERVER" in
  serve)      exec "$PHP" artisan serve --host=127.0.0.1 --port=8000 ;;
  roadrunner) exec env OCTANE_SERVER=roadrunner "$PHP" artisan octane:start --server=roadrunner --port=8000 ;;
  frankenphp)
    FDIR="${FPHP_DIR:-/tmp/frankenphp}"
    export PATH="$FDIR:$PATH"
    exec env OCTANE_SERVER=frankenphp "$PHP" artisan octane:start --server=frankenphp --port=8000 ;;
  *) echo "SERVER=$SERVER not in {serve,roadrunner,frankenphp}"; exit 2 ;;
esac
