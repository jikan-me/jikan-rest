###
# App
###
APP_ENV=production
APP_NAME=Jikan
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_VERSION="4.2.2"
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

###
# Logging
###
LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=daily

# Papertrail (used when LOG_CHANNEL=papertrail)
LOG_PAPERTRAIL_HANDLER=Monolog\Handler\SyslogUdpHandler
PAPERTRAIL_URL=
PAPERTRAIL_PORT=

###
# Database (MongoDB)
###
DB_CONNECTION=mongodb
DB_HOST=localhost
DB_PORT=27017
DB_DATABASE=jikan
DB_ADMIN=jikan
DB_USERNAME=
DB_PASSWORD=

###
# Database query default values
###
MAX_RESULTS_PER_PAGE=25

###
# Enable MyAnimeList Heartbeat
#
# Monitor bad requests to determine whether MyAnimeList is down
###
# Recheck source availability (in seconds)
SOURCE_BAD_HEALTH_RECHECK=10
# Fail count only within specified time range (in seconds)
SOURCE_BAD_HEALTH_RANGE=30
# Max Fail stores
SOURCE_BAD_HEALTH_MAX_STORE=50
# Disable failover if the score reaches the following (0.0-1.0 values ONLY)
# e.g 0.9 means 90% successful requests to MyAnimeList
SOURCE_GOOD_HEALTH_SCORE=0.9
# Max time request is allowed to take
# https://curl.haxx.se/libcurl/c/CURLOPT_TIMEOUT.html
SOURCE_TIMEOUT=10

###
# Caching (File, Redis, Memcached, DB, etc)
###
CACHE_DRIVER=array

# Caching TTL (in seconds) on specific endpoints
CACHE_DEFAULT_EXPIRE=86400 # 1 day
CACHE_USER_EXPIRE=300 # 5 minutes
CACHE_USERLIST_EXPIRE=3600 # 1 hour
CACHE_SEARCH_EXPIRE=432000 # 5 days
CACHE_MAGAZINE_EXPIRE=432000 # 5 days

# Cache store settings (used by the matching CACHE_DRIVER)
CACHE_PREFIX=jikan
CACHE_DATABASE_CONNECTION=
CACHE_DATABASE_TABLE=cache
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

###
# Redis Caching Configuration
###
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_REDIS_CONNECTION=default

###
# Micro Caching
# Uses CACHE_DRIVER
###
MICROCACHING=false
MICROCACHING_EXPIRE=60

###
# Queue management
# Uses QUEUE_CONNECTION as queue storage (MongoDB, Redis, etc)
###
QUEUE_CONNECTION=database
QUEUE_TABLE=jobs
QUEUE_FAILED_TABLE=jobs_failed
QUEUE_DELAY_PER_JOB=5
MONGODB_DSN=
QUEUE_REDIS_CONNECTION=default

###
# Session & Authentication
###
AUTH_GUARD=web
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_COOKIE=jikan_session
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=

###
# Mail
###
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Jikan

###
# Scout search config
#
# Search is disabled by default (driver `null`).
# For TypeSense use: typesense — for Algolia use: algolia
###
SCOUT_DRIVER=null
SCOUT_QUEUE=false
SCOUT_PREFIX=
SCOUT_IDENTIFY=false

# Algolia credentials (used when SCOUT_DRIVER=algolia)
ALGOLIA_APP_ID=
ALGOLIA_SECRET=

###
# TypeSense Config (used when SCOUT_DRIVER=typesense)
###
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
TYPESENSE_TEXT_MATCH_BUCKETS=1
TYPESENSE_TYPO_TOKENS_THRESHOLD=
TYPESENSE_DROP_TOKENS_THRESHOLD=
TYPESENSE_SEARCH_CUTOFF_MS=450
TYPESENSE_ENABLE_EXHAUSTIVE_SEARCH=false

###
# GitHub generate report URL on fatal errors
###
GITHUB_REPORTING=true
GITHUB_REST="jikan-me/jikan-rest"
GITHUB_API="jikan-me/jikan"

###
# OpenAPI docs (l5-swagger)
###
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_GENERATE_YAML_COPY=false
L5_SWAGGER_PROXY=false
L5_SWAGGER_UI_ASSETS_PATH="vendor/swagger-api/swagger-ui/dist/"
L5_SWAGGER_USE_ABSOLUTE_PATH=true
L5_FORMAT_TO_USE_FOR_DOCS=json
#L5_SWAGGER_BASE_PATH=
#L5_SWAGGER_OPERATIONS_SORT=

###
# Error reporting (Sentry)
# Sentry is only registered when REPORTING=true and REPORTING_DRIVER=sentry.
###
REPORTING=false
REPORTING_DRIVER=sentry
SENTRY_DSN=
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACE_QUEUE_ENABLED=false
SENTRY_CONTROLLERS_BASE_NAMESPACE=App\Http\Controllers

###
# Hashing & Filesystem
###
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local
# Compiled view templates path (falls back to storage/framework/views)
#VIEW_COMPILED_PATH=

###
# Endpoints
###
DISABLE_USER_LISTS=false

###
# Security (P0)
# Dedicated token for the internal cache-bypass used by the cache-refresh jobs.
# Empty (default) disables the bypass. Never reuse APP_KEY here.
# Set a strong random value in production.
CACHE_BYPASS_TOKEN=

###
# CORS
# Off by default (as on the Lumen release). Set to true to have the app answer
# CORS itself (all origins, GET/OPTIONS). Leave off if your proxy already does.
###
CORS_MIDDLEWARE=false

###
# Rate limiting
# Public v4 per-IP requests per minute (applied via the `throttle:v4` middleware).
# 0 = disabled (default). Enable only with a shared cache store
# (CACHE_DRIVER=redis; the `array` store is per worker process) and with
# TRUSTED_PROXIES set to your edge, otherwise every client behind the proxy
# shares a single bucket.
RATE_LIMIT_PER_MINUTE=0

###
# Reverse proxy
# Comma-separated IPs/CIDRs of the proxies/load balancers in front of the app,
# or `*` to trust all (only do that if the app is unreachable except via the
# proxy). Empty = trust nothing, request()->ip() is the TCP peer.
TRUSTED_PROXIES=

###
# Queue workers
# Number of `php artisan queue:work` processes the container entrypoint starts
# next to Octane (replaces the old RoadRunner `laravel_queue_worker_1` service).
# 0 = none. Needed when SCOUT_QUEUE=true or jobs are dispatched.
###
QUEUE_WORKERS=0

###
# Octane runtime
###
OCTANE_SERVER=roadrunner
OCTANE_HTTPS=false
OCTANE_ROADRUNNER_COMMAND=vendor/bin/roadrunner-worker
OCTANE_ROADRUNNER_HTTP_MIDDLEWARE=static
#OCTANE_STATE_FILE=
