{
    "name": "jikan-rest/laravel",
    "description": "Jikan - Unofficial MyAnimeList PHP API (Laravel 13 modernization fork).",
    "keywords": ["framework", "laravel", "anime", "myanimelist"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mongodb": "*",
        "ext-pcntl": "*",
        "darkaonline/l5-swagger": "^11.0",
        "jikan-me/jikan": "^5.0@beta",
        "jms/serializer": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.0",
        "laravel/scout": "^11.0",
        "league/flysystem": "^3.0",
        "mongodb/laravel-mongodb": "^5.0",
        "predis/predis": "^2.3",
        "sentry/sentry-laravel": "^4.0",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-enum": "^3.3",
        "spiral/roadrunner-http": "^4.1",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/dom-crawler": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/yaml": "^7.0",
        "typesense/typesense-php": "^6.0",
        "zircote/swagger-php": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "haydenpierce/class-finder": "^0.4.4",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/pint": "^1.32",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.0",
        "spiral/roadrunner-cli": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Goutte\\": "app/Compat/Goutte/",
            "Database\\Factories\\": "database/factories/"
        },
        "files": [
          "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
          "Tests\\": ["tests/"]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"copy('.env.dist', '.env');\""
        ],
        "phpunit": "@php ./vendor/bin/phpunit --no-coverage",
        "phpunit-cover": "@php ./vendor/bin/phpunit",
        "phpstan": "@php -d error_reporting=24575 -d memory_limit=-1 vendor/bin/phpstan analyse --no-progress",
        "pint": "@php ./vendor/bin/pint",
        "pint:test": "@php ./vendor/bin/pint --test",
        "test": [
          "@phpunit --testsuite unit"
        ],
        "integration-test": [
          "@phpunit --testsuite integration"
        ],
        "test-cover": [
          "@phpunit-cover"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.26"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    }
}
