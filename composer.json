{
    "name": "laravel/lumen",
    "description": "The Laravel Lumen Framework.",
    "keywords": ["framework", "laravel", "lumen"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mongodb": "*",
        "ext-pcntl": "*",
        "amphp/http-client": "^4.6",
        "danielmewes/php-rql": "dev-master",
        "darkaonline/l5-swagger": "^11.0",
        "jikan-me/jikan": "^4",
        "jms/serializer": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.0",
        "laravel/scout": "^11.0",
        "league/flysystem": "^3.0",
        "mirazmac/dotenvwriter": "^0.1.0",
        "mongodb/laravel-mongodb": "^5.0",
        "predis/predis": "^2.3",
        "sentry/sentry-laravel": "^4.0",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-enum": "^3.3",
        "spiral/roadrunner-http": "^4.1",
        "symfony/browser-kit": "^7.0",
        "symfony/css-selector": "^7.0",
        "symfony/dom-crawler": "^7.0",
        "symfony/http-client": "^7.0",
        "symfony/yaml": "^7.0",
        "typesense/typesense-php": "^6.0",
        "vlucas/phpdotenv": "^5",
        "zircote/swagger-php": "^6.0"
    },
    "replace": {
        "fabpot/goutte": "4.0.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "haydenpierce/class-finder": "^0.4.4",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0",
        "spiral/roadrunner-cli": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Goutte\\": "app/Compat/Goutte/",
            "Database\\Factories\\": "database/factories/"
        },
        "files": [
          "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
          "Tests\\": ["tests/"]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"copy('.env.dist', '.env');\""
        ],
        "phpunit": "@php ./vendor/bin/phpunit --no-coverage",
        "phpunit-cover": "@php ./vendor/bin/phpunit",
        "test": [
          "@phpunit --testsuite unit"
        ],
        "integration-test": [
          "@phpunit --testsuite integration"
        ],
        "test-cover": [
          "@phpunit-cover"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    }
}
