includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app

    # Analysis level. Level 6 is now the standing level; the Lumen-era missing
    # type hints/generics surfaced by level 6 (1000+ findings) are pinned in
    # phpstan-baseline.neon so `vendor/bin/phpstan analyse` exits 0. Burn the
    # baseline down as code is type-lined (regenerate with
    # `--generate-baseline`), then target level 7+.
    level: 6

    tmpDir: storage/framework/cache/phpstan

    parallel:
        # Keep memory bounded when running in CI (2 workers on small runners).
        maximumNumberOfProcesses: 2

    # Run with `-d error_reporting=24575` (see composer "phpstan" script / CI)
    # to keep PHP 8.4 deprecation warnings from the legacy scraper stack out of
    # the output — they are not analysis findings.
    bootstrapFiles:
        - vendor/autoload.php