includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon
    - phpstan-l7-baseline.neon

parameters:
    paths:
        - app

    # Level 7 is the standing level. Level-6 findings live in
    # phpstan-baseline.neon; the L7 delta lives in phpstan-l7-baseline.neon so
    # `vendor/bin/phpstan analyse` exits 0. Burn both baselines down as code is
    # type-lined.
    level: 7

    tmpDir: storage/framework/cache/phpstan

    parallel:
        # Keep memory bounded when running in CI (2 workers on small runners).
        maximumNumberOfProcesses: 2

    # Run with `-d error_reporting=24575` (see composer "phpstan" script / CI)
    # to keep PHP 8.4 deprecation warnings from the legacy scraper stack out of
    # the output — they are not analysis findings.
    bootstrapFiles:
        - vendor/autoload.php